/// One row per (tournament, team) — FIFA ranking vs finish. Source: SHARED.EXPECTED_VS_ACTUAL. 2026 uses real stage_order; 2022/1994 use a match-count proxy (actual_finish_method column).
table 'Expected Vs Actual'
	lineageTag: d36e64fe-4c7c-4684-929b-64d616473ac1

	column tournament_year
		dataType: int64
		lineageTag: 23ed1794-da86-4dd9-b2f2-6b88ea7f46ef
		summarizeBy: none
		sourceColumn: TOURNAMENT_YEAR

	column team_name
		dataType: string
		lineageTag: c0ae8334-4a98-4f63-96f4-5cf3cabec795
		summarizeBy: none
		sourceColumn: TEAM_NAME

	column fifa_ranking
		dataType: int64
		lineageTag: 3ea55e0f-f906-41f0-932a-8775bff64e71
		summarizeBy: none
		sourceColumn: FIFA_RANKING

	column matches_played
		dataType: int64
		lineageTag: 60be7b0b-8098-4a92-896e-86ab47f3bae8
		summarizeBy: none
		sourceColumn: MATCHES_PLAYED

	column furthest_stage_order
		dataType: int64
		lineageTag: 71a37519-4fa8-41c5-ad6b-17bb45535649
		summarizeBy: none
		sourceColumn: FURTHEST_STAGE_ORDER

	column actual_finish_method
		dataType: string
		lineageTag: 9cdc3cd2-2d9b-4dfa-a31a-d6282b331df0
		summarizeBy: none
		sourceColumn: ACTUAL_FINISH_METHOD

	partition 'Expected Vs Actual' = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeAccount, "COMPUTE_WH"),
				    WC2026_Database = Source{[Name="WC2026",Kind="Database"]}[Data],
				    SHARED_Schema = WC2026_Database{[Name="SHARED",Kind="Schema"]}[Data],
				    View = SHARED_Schema{[Name="EXPECTED_VS_ACTUAL",Kind="View"]}[Data]
				in
				    View

